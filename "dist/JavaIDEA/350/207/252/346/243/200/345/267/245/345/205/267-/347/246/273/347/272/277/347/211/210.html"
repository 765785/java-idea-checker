.auth-summary {
  font-weight: 700;
  color: #27466f;
}

.auth-block {
  background: #fff;
  border: 1px solid #c9dcf5;
  border-left: 4px solid #6d829e;
  border-radius: 7px;
  margin: 16px 0;
  padding: 18px;
}

.auth-block:has(.badge.PASS) { border-left-color: #29a366; }
.auth-block:has(.badge.WARN) { border-left-color: #d69522; }

.auth-title {
  align-items: center;
  display: flex;
  gap: 12px;
  justify-content: space-between;
}

.auth-title h4 { margin: 0; }

.auth-block pre {
  background: #f3f6fa;
  border-radius: 5px;
  font: 12px/1.65 Consolas, "Cascadia Mono", monospace;
  margin: 10px 0 0;
  max-height: 180px;
  overflow: auto;
  overflow-wrap: anywhere;
  padding: 10px;
  white-space: pre-wrap;
}

.auth-block textarea { margin-bottom: 8px; }

.check {
  align-items: center;
  display: flex;
  font-weight: 400;
  gap: 8px;
}

.check input { width: auto; }

.final-action {
  background: #fffaf2;
  border-color: #f0d9b2;
}

/* 两类内容的来源不同：本机脚本结果与官网页面文本绝不使用同一种视觉语言。 */
.auth-step { margin-top: 72px; }

.paste-origin {
  border-radius: 999px;
  display: inline-block;
  font-size: 12px;
  margin-right: 8px;
  padding: 3px 8px;
  vertical-align: 2px;
}

.local-origin { background: #fff0df; color: #9b4d08; }
.portal-origin { background: #e7f1ff; color: #155a99; }

.paste-box.local-paste {
  background: #fffaf5;
  border: 2px solid #e6a15c;
  box-shadow: inset 0 0 0 1px #fff;
}

.paste-box.portal-paste {
  background: #f5f9ff;
  border: 2px solid #4a91d7;
  box-shadow: inset 0 0 0 1px #fff;
}

.paste-state {
  color: #637083;
  font-size: 13px;
  margin: 6px 0;
}

.paste-state[data-state="filled"] { color: #197548; font-weight: 700; }

.paste-guidance { min-height: 0; }
.paste-guidance:empty { display: none; }
.paste-guidance:not(:empty) {
  align-items: center;
  background: #fff3f1;
  border: 1px solid #e9aaa1;
  border-radius: 6px;
  color: #8f2b22;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 8px 0;
  padding: 9px 11px;
}
.paste-guidance p { margin: 0; }
.paste-guidance button { font-size: 13px; padding: 6px 9px; }

.paste-target {
  animation: paste-target-pulse 1.8s ease-out;
  outline: 4px solid #276fb9;
  outline-offset: 4px;
}

@keyframes paste-target-pulse {
  0%, 45% { outline-color: #276fb9; }
  100% { outline-color: transparent; }
}

@media (max-width: 520px) {
  .auth-title { align-items: flex-start; flex-direction: column; }
  .auth-step { margin-top: 44px; }
}
